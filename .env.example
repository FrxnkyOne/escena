# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# ── LLM (agnóstico del proveedor) ─────────────────────────
# Cualquier servidor que exponga la API estándar /chat/completions:
#   Ollama:    http://localhost:11434/v1        (qwen2.5, deepseek-r1, llama3.3…)
#   vLLM:      http://localhost:8000/v1
#   LM Studio: http://localhost:1234/v1
#   Servidor propio remoto: https://llm.tudominio.com/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b
# Opcional, solo si tu servidor exige token:
LLM_API_KEY=

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
